<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Beatriz — Projeto Acessível</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <!-- Skip link -->
  <a class="skip-link" href="#main">Ir para o conteúdo principal</a>

  <header class="site-header" role="banner">
    <div class="container header-inner">
      <a class="brand" href="#" aria-label="Ir para a página inicial — Beatriz">
        <img src="assets/img/logo.png" alt="Logotipo Beatriz" width="48" height="48" />
        <span>Beatriz</span>
      </a>

      <button id="nav-toggle" class="nav-toggle" aria-controls="primary-nav" aria-expanded="false" aria-label="Abrir menu">
        ☰
      </button>

      <nav id="primary-nav" class="primary-nav" role="navigation" aria-label="Navegação principal">
        <ul>
          <li><a href="#sobre">Sobre</a></li>
          <li><a href="#servicos">Serviços</a></li>
          <li><a href="#galeria">Galeria</a></li>
          <li><a href="#contato">Contato</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main" class="container" role="main">
    <section id="hero" class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title">Projeto Beatriz — Acessibilidade em primeiro lugar</h1>
      <p>Exemplo de landing page com padrões de acessibilidade: semântica, contraste, navegação por teclado e formulários acessíveis.</p>
      <p><a class="btn" href="#contato">Fale conosco</a></p>
    </section>

    <section id="sobre" aria-labelledby="sobre-title">
      <h2 id="sobre-title">Sobre</h2>
      <p>Este projeto demonstra como criar uma página web simples e acessível para apresentação de um trabalho escolar.</p>
    </section>

    <section id="servicos" aria-labelledby="servicos-title">
      <h2 id="servicos-title">Serviços</h2>
      <ul class="cards" role="list">
        <li class="card" role="listitem">
          <h3>Consultoria</h3>
          <p>Avaliação de acessibilidade e recomendações.</p>
        </li>
        <li class="card" role="listitem">
          <h3>Design</h3>
          <p>Layouts responsivos e acessíveis.</p>
        </li>
        <li class="card" role="listitem">
          <h3>Teste</h3>
          <p>Testes com teclado e leitores de tela.</p>
        </li>
      </ul>
    </section>

    <section id="galeria" aria-labelledby="galeria-title">
      <h2 id="galeria-title">Galeria</h2>
      <p>Imagens com texto alternativo e botão para abrir em modal acessível.</p>

      <ul class="gallery" role="list">
        <li>
          <button class="thumb" data-full="assets/img/sample1.jpg" aria-label="Abrir imagem 1">Imagem 1</button>
        </li>
        <li>
          <button class="thumb" data-full="assets/img/sample2.jpg" aria-label="Abrir imagem 2">Imagem 2</button>
        </li>
        <li>
          <button class="thumb" data-full="assets/img/sample3.jpg" aria-label="Abrir imagem 3">Imagem 3</button>
        </li>
      </ul>
    </section>

    <section id="contato" aria-labelledby="contato-title">
      <h2 id="contato-title">Contato</h2>
      <form id="contact-form" action="#" method="post" novalidate>
        <div class="field">
          <label for="nome">Nome</label>
          <input id="nome" name="nome" required aria-required="true" />
          <span class="error" id="nome-error" aria-live="polite"></span>
        </div>

        <div class="field">
          <label for="email">E-mail</label>
          <input id="email" name="email" type="email" required aria-required="true" />
          <span class="error" id="email-error" aria-live="polite"></span>
        </div>

        <div class="field">
          <label for="mensagem">Mensagem</label>
          <textarea id="mensagem" name="mensagem" rows="4"></textarea>
          <span class="hint">Opcional — descreva sua dúvida ou pedido.</span>
        </div>

        <button class="btn" type="submit">Enviar</button>

        <div id="form-status" role="status" aria-live="polite" class="form-status"></div>
      </form>
    </section>
  </main>

  <footer class="site-footer" role="contentinfo">
    <div class="container">
      <p>&copy; <span id="year"></span> Beatriz — Projeto Acessível</p>
      <p><a href="#top">Voltar ao topo</a></p>
    </div>
  </footer>

  <!-- Modal Acessível -->
  <div id="img-modal" class="modal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Visualizador de imagem">
    <div class="modal-content">
      <button id="modal-close" class="modal-close" aria-label="Fechar visualizador">×</button>
      <img id="modal-img" src="" alt="" />
    </div>
  </div>

  <script src="script.js"></script>
</body>
</html>
